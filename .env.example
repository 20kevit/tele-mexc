# tg-signal-ingest — environment template.
# Copy these into a private `.env` (never commit it) or run `tg-ingest config init`.
# See docs/OPERATIONS.md section 3 for obtaining the Telegram API credentials.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: run a second, separate Telethon session for another Telegram
# account without touching the default/employer session file. Point it at a new
# path and log in from the terminal:
#   TG_SESSION_PATH=config/tg_session_personal .venv/bin/tg-ingest auth login
# TG_SESSION_PATH=

# Telegram Bot API and MTProto both use direct networking. No proxy settings
# are required or read by this project.

# MEXC Spot API (official Spot v3). Missing credentials fail closed; there is no
# simulation mode. Create a key with ONLY spot read + spot trade permissions; use
# an IP allowlist. NEVER commit these values and never enable withdrawal.
MEXC_API_KEY=
MEXC_API_SECRET=
# Official base URL (must remain https://):
MEXC_BASE_URL=https://api.mexc.com

# Permanent automatic execution; no acknowledgement token or mode selector.
# Fixed per-order quote amount; never taken from a signal.
# TRADING_ORDER_QUOTE_AMOUNT=3
# Entry orders are LIMIT-only. order_type_policy/MARKET execution are rejected.
# Conditional LIMIT entry trigger offset lives in [trading] config.toml.
# Default is exactly 3 exchange ticks below Entry; it is not disableable.
# entry_trigger_offset_ticks = 3

# Telegram control bot. The bot token is from @BotFather.
# Authorization uses numeric Telegram user IDs only (never usernames).
# Owner A and Owner B are both required for the first controlled start and have
# full owner-level controls. The programmer is NOT an owner: it receives every
# event and technical diagnostics but only has read-only diagnostic commands.
# Generate CONTROL_SECRET_KEY once with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# It encrypts MEXC credentials at rest. Never reuse it or commit it.
CONTROL_BOT_TOKEN=
CONTROL_OWNER_USER_ID=
CONTROL_OWNER_B_USER_ID=
CONTROL_DEVELOPER_USER_ID=
CONTROL_SECRET_KEY=
# Login codes and 2FA passwords are accepted only by the SSH terminal flow
# (`tg-ingest auth login`), never by the bot or any Telegram chat.
# Optional: explicit disable even if token and owner are set.
# CONTROL_BOT_ENABLED=false
# CONTROL_API_BASE=https://api.telegram.org
