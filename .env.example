# tg-signal-ingest — environment template.
# Copy these into a private `.env` (never commit it) or run `tg-ingest config init`.
# See docs/OPERATIONS.md section 3 for obtaining the Telegram API credentials.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Proxy used for ALL Telegram traffic (MTProto). Explicit on purpose:
# Telethon does NOT honour HTTP_PROXY/HTTPS_PROXY environment variables.
TELEGRAM_PROXY_TYPE=http
TELEGRAM_PROXY_HOST=127.0.0.1
TELEGRAM_PROXY_PORT=1081
# Optional proxy auth, if the listener requires it:
# TELEGRAM_PROXY_USERNAME=
# TELEGRAM_PROXY_PASSWORD=
