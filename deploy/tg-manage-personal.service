[Unit]
Description=Telegram two-operator management bot using the personal operator session (preview and developer self-authorized bounded validation, no trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/projects/akha1
# Use a separate Telethon session so the employer/default session file is never
# overwritten, logged out, or modified. This unit shares the same bot token and
# database as tg-manage.service, so only one of the two may run at a time.
Environment=TG_SESSION_PATH=config/tg_session_personal
ExecStart=/opt/projects/akha1/.venv/bin/tg-ingest manage run
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectHome=no
Environment=PYTHONUNBUFFERED=1
# Direct networking only: strip ambient/legacy proxy variables if present.
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy TELEGRAM_PROXY_TYPE TELEGRAM_PROXY_HOST TELEGRAM_PROXY_PORT TELEGRAM_PROXY_USERNAME TELEGRAM_PROXY_PASSWORD

[Install]
WantedBy=multi-user.target
